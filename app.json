{
  "expo": {
    "experiments": {
      "reactCanary": true
    },
    "name": "CromEcuApp",
    "slug": "CromEcuApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/clock.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/hourglass.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/schedule.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.vaquisha.CromEcuApp"
    },
    "web": {
      "favicon": "./assets/favicon.ico"
    },
    "plugins": [
      "expo-font",
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "08b1dd3c-d226-48d8-b235-b014e9c2617f"
      }
    }
  }
}
